<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <AssemblyName>vanillaStorageExtend</AssemblyName>
        <RootNamespace>VanillaStorageExtend</RootNamespace>
        <Version>1.0.0.0</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

        <!-- 娓告垙瀹夎鐩綍锛堝惈 Duckov.exe锛夈€傚彲鐢?-p:DuckovPath="..." 瑕嗙洊 -->
        <DuckovPath Condition="'$(DuckovPath)' == ''">E:\Steam\steamapps\common\Escape from Duckov</DuckovPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="src\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\TeamSoda.*">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\ItemStatsSystem.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\SodaLocalization.dll">
            <Private>False</Private>
        </Reference>
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\Unity*">
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <!-- 鍐呭祵鍥炬爣锛歀ogicalName 蹇呴』涓庡師 DLL 鍐呯殑璧勬簮鍚嶄竴鑷?-->
    <ItemGroup>
        <EmbeddedResource Include="resources\*.png" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="info.ini;preview.png" CopyToOutputDirectory="PreserveNewest" />
        <None Include="language\*.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- 鏋勫缓瀹岃嚜鍔ㄦ暣鐞嗘垚鍙洿鎺ユ斁杩?Mods/ 鐨勬枃浠跺す -->
    <Target Name="PackModFolder" AfterTargets="Build">
        <ItemGroup>
            <ModPayload Include="$(TargetPath)" />
            <ModPayload Include="$(MSBuildProjectDirectory)\info.ini" />
            <ModPayload Include="$(MSBuildProjectDirectory)\preview.png" />
            <LanguagePayload Include="$(MSBuildProjectDirectory)\language\*.txt" />
        </ItemGroup>
        <Copy SourceFiles="@(ModPayload)"
              DestinationFolder="$(OutputPath)Mod\VanillaStorageExtend"
              SkipUnchangedFiles="false" />
        <Copy SourceFiles="@(LanguagePayload)"
              DestinationFolder="$(OutputPath)Mod\VanillaStorageExtend\language"
              SkipUnchangedFiles="false" />
    </Target>

</Project>
